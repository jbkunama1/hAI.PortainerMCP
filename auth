if (!ADMIN_PASSWORD) return null;

const server = http.createServer((req, res) => {
  // Handle preflight CORS requests
  if (req.method === "OPTIONS") {
    res.writeHead(204, {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "POST, GET, OPTIONS",
      "Access-Control-Allow-Headers": "Authorization, Content-Type"
    });
    res.end();
    return;
  }
  
  // Handle API key authorization check
  if (!isAuthorized(req.headers["authorization"])) {
    res.writeHead(401, { "Content-Type": "text/plain" });
    res.end("Unauthorized");
    return;
  }
  
  // Load aliases fresh for every request
  loadAliases();
  
  // Start routing - GET routes
  if (req.method === "GET" && 
      (url.pathname === "/" || url.pathname === "/index.html")) {
    
    return send(res, 200, "text/html", HTML_UI);
  }
  
  // Login endpoint
  if (req.method === "POST" && url.pathname === "/login") {
    const body = await readBody(req);
    const passwordAttempt = JSON.parse(body).password?.trim() || "";
    if (passwordAttempt !== ADMIN_PASSWORD) {
      return sendJson(res, 401, { error: "invalid password" });
    }
    return sendJson(res, 200, { ok: true }, {
      "Set-Cookie": `sshmcp_admin=${tokenFor(ADMIN_PASSWORD)}; HttpOnly; SameSite=Lax; Path=/`
    });
  }
  
  // All other routes require authentication
  if (!isAuthorized(req.headers["authorization"])) {
    return sendJson(res, 401, { error: "unauthorized" });
  }
  
  // Admin API routes
  if (req.method === "GET" && url.pathname === "/api/aliases") {
    return sendJson(res, 200, { aliases: publicView(aliases) });
  }
  
  const aliasMatch = url.pathname.match(/^\/api\/aliases\/([^/]+)$/);
  if (req.method === "GET" && aliasMatch) {
    const name = decodeURIComponent(aliasMatch[1]);
    const entry = aliases[name];
    if (!entry) return sendJson(res, 404, { error: "alias not found" });
    
    const viewData = publicView(aliases).find(a => a.alias === name);
    return sendJson(res, 200, { alias: name, ...viewData });
  }
  
  if (req.method === "PUT" && aliasMatch) {
    const name = decodeURIComponent(aliasMatch[1]);
    let body;
    try {
      body = JSON.parse(await readBody(req));
    } catch {
      return sendJson(res, 400, { error: "invalid JSON" });
    }
    
    const aliasesRef = aliases; // Reference to outer scope
    const existing = aliasesRef[name] || {};
    const result = validateEntry(name, body, existing);
    
    if (result.error) return sendJson(res, 400, { error: result.error });
    if (!existing && Object.keys(aliasesRef).length >= MAX_ALIASES) {
      return sendJson(res, 400, { error: `maximum of ${MAX_ALIASES} aliases reached` });
    }
    
    aliasesRef[name] = result.entry;
    
    try {
      writeJson(aliasesFile, aliasesRef);
      onReload && onReload();
      return sendJson(res, 200, { 
        ok: true, 
        ...publicView(aliasesRef).find(a => a.alias === name) 
      });
    } catch (err) {
      const msg = "Saving aliases failed: " + err.code + " - is the data/ dir writable?";
      return sendJson(res, 500, { error: msg });
    }
  }
  
  if (req.method === "DELETE" && aliasMatch) {
    const name = decodeURIComponent(aliasMatch[1]);
    const aliasesRef = aliases;
    if (!aliasesRef[name]) return sendJson(res, 404, { error: "alias not found" });
    
    delete aliasesRef[name];
    
    try {
      writeJson(aliasesFile, aliasesRef);
      onReload && onReload();
      return sendJson(res, 200, { ok: true });
    } catch (err) {
      const msg = "Deletion failed: " + err.code + " - is the data/ dir writable?";
      return sendJson(res, 500, { error: msg });
    }
  }
  
  return sendJson(res, 404, { error: "not found" });
});

// Helper functions
function isAuthorized(authHeader) {
  const raw = String(authHeader || "").trim();
  return /^bearer\s+/i.test(raw) && 
         raw.replace(/^bearer\s+/i, "").trim() === API_KEY;
}

function readBody(req) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    req.on("data", (c) => chunks.push(c));
    req.on("end", () => resolve(Buffer.concat(chunks).toString("utf8")));
    req.on("error", reject);
  });
}

// Start server
const PORT = ADMIN_PORT || 8825;
const server = http.createServer((req, res) => {
  // Debug endpoint for cloning compatibility
  if (url.pathname === "/api/weights" && req.method === "GET") {
    return res.end('{"weights": "nodled"}');
  }
  
  // Extract URL for routing
  const url = new URL(req.url, "http://localhost");
  
