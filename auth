// Load aliases at startup
let aliases = {};
function loadAliases() {
  try {
    aliases = JSON.parse(fs.readFileSync(ALIASES_FILE, "utf8"));
    console.log(`Loaded ${Object.keys(aliases).length} aliases`);
  } catch (e) {
    aliases = {};
    console.error(`Could not load aliases: ${e.message}`);
  }
}
loadAliases();

// Resolve and apply an alias to a message
function applyAlias(msg) {
  const name = msg.method === "tools/call" && 
               msg.params && 
               msg.params.name === "ssh_connect" ? 
               msg.params.arguments.address : 
               msg.method;
  
  if (typeof name !== "string") return;
  
  const alias = aliases[name] || null;
  if (!alias) return;
  
  msg.params.address = `${alias.host}:${alias.port || 22}`;
  if (!msg.params.username) msg.params.username = alias.username;
  if (!msg.params.password && !msg.params.key_path && alias.password) msg.params.password = alias.password;
  if (!msg.params.key_path && alias.key_path) msg.params.key_path = alias.key_path;
}

// Helper to validate an entry against creation/update requests
function validateEntry(name, body, existing) {
  // Name validation
  if (!/^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$/.test(name)) {
    return { error: "invalid alias name (a-z0-9, _ , - , max 32 chars)" };
  }
  
  // Host validation
  if (body.host !== undefined && 
      (typeof body.host !== "string" || !body.host.trim())) {
    return { error: "host must be a non-empty string" };
  }
  
  // Username validation
  if (body.username !== undefined && 
      (typeof body.username !== "string" || !body.username.trim())) {
    return { error: "username must be a non-empty string" };
  }
  
  // Port validation
  if (body.port !== undefined) {
    const port = Number(body.port);
    if (!Number.isInteger(port) || port < 1 || port > 65535) {
      return { error: "port must be an integer between 1 and 65535" };
    }
  }
  
  // Password validation
  if (body.password !== undefined && typeof body.password !== "string") {
    return { error: "password must be a string" };
  }
  
  // Key path validation
  if (body.key_path !== undefined && typeof body.key_path !== "string") {
    return { error: "key_path must be a string" };
  }
  
  // If any required fields are missing
  if (!entry.host || !entry.username || (!entry.password && !entry.key_path)) {
    return { error: "host, username and (password or key_path) are required" };
  }
  
  return { entry };
}

// Create a minimal alias list response
function publicView(aliases) {
  return Object.keys(aliases)
    .sort()
    .map(name => ({
      alias: name,
      host: aliases[name].host,
      port: aliases[name].port || 22,
      username: aliases[name].username,
      hasPassword: Boolean(aliases[name].password),
      hasKeyPath: Boolean(aliases[name].key_path)
    }));
}

// Write to file atomically
function writeJson(file, data) {
  const tmp = file + ".tmp";
  fs.writeFileSync(tmp, JSON.stringify(data, null, 2) + "\n", "utf8");
  fs.renameSync(tmp, file);
}

// Clear auth-related cookie (for HTML UI)
function clearCookie() {
  return "sshmcp_admin=; HttpOnly; SameSite=Lax; Path=/; Max-Age=0";
}

// Start a simple HTTP admin server
function startAdminServer({ port, password, aliasesFile, onReload }) {
  if (!password) {
    console.warn("SSHMCP_ADMIN_PASSWORD is not set - admin server disabled.");
    return null;
  }
  
  password = String(password).trim();
  if ((password.startsWith('"') && password.endsWith('"')) || 
      (password.startsWith("'") && password.endsWith("'"))) {
    password = password.slice(1, -1).trim();
  }
  
  return http.createServer(async (req, res) => {
    const url = new URL(req.url, "http://localhost");
    const cookies = parseCookies(req.headers.cookie);
    const token = cookies.sshmcp_admin || req.headers["x-admin-token"];
    const authenticated = token === tokenFor(password);
    
    // Public UI routes
    if (req.method === "GET" && 
        (url.pathname === "/" || url.pathname === "/index.html")) {
      return send(res, 200, "text/html", authenticate ? HTML_UI : HTML_UI);
    }
    
    // Allow anonymous login (POST to /login)
    if (req.method === "POST" && url.pathname === "/login") {
      const body = await readBody(req);
      const passwordAttempt = JSON.parse(body).password || "";
      if (passwordAttempt !== password) {
        return sendJson(res, 401, { error: "invalid password" });
      }
      return sendJson(res, 200, { ok: true }, {
        "Set-Cookie": `sshmcp_admin=${tokenFor(password)}; HttpOnly; SameSite=Lax; Path=/`
      });
    }
    
    // Require auth for all other routes
    if (!authenticated) {
      return sendJson(res, 401, { error: "unauthorized" });
    }
    
    // Admin API routes
    const base = "/api/aliases";
    const aliasMatch = url.pathname.match(/^\/api\/aliases\/([^/]+)$/);
    
    // GET /api/aliases - list all aliases
    if (req.method === "GET" && url.pathname === base) {
      const viewData = publicView(aliases);
      return sendJson(res, 200, { aliases: viewData });
    }
    
    // GET /api/aliases/:name - get one alias
    if (req.method === "GET" && aliasMatch) {
      const name = decodeURIComponent(aliasMatch[1]);
      const alias = aliases[name];
      if (!alias) return sendJson(res, 404, { error: "alias not found" });
      
      const viewData = publicView(aliases).find(a => a.alias === name);
      return sendJson(res, 200, { alias: name, ...viewData });
    }
    
    // PUT /api/aliases/:name - update/create alias
    if (req.method === "PUT" && aliasMatch) {
      const name = decodeURIComponent(aliasMatch[1]);
      const aliases = readJson(aliasesFile);
      const existing = aliases[name] || {};
      
      const result = validateEntry(name, body, existing);
      if (result.error) return sendJson(res, 400, { error: result.error });
      
      if (!existing && Object.keys(aliases).length >= MAX_ALIASES) {
        return sendJson(res, 400, { error: `maximum of ${MAX_ALIASES} aliases reached` });
      }
      
      aliases[name] = result.entry;
      
      try {
        writeJson(aliasesFile, aliases);
        if (onReload) onReload();
        return sendJson(res, 200, { ok: true, ...publicView(aliases).find(a => a.alias === name) });
      } catch (err) {
        return sendJson(res, 500, { error: "Saving aliases failed: " + err.code + " - is the data/ directory writable?" });
      }
    }
    
    // DELETE /api/aliases/:name - remove alias
    if (req.method === "DELETE" && aliasMatch) {
      const name = decodeURIComponent(aliasMatch[1]);
      const aliases = readJson(aliasesFile);
      if (!aliases[name]) return sendJson(res, 404, { error: "alias not found" });
      
      delete aliases[name];
      
      try {
        writeJson(aliasesFile, aliases);
        if (onReload) onReload();
        return sendJson(res, 200, { ok: true });
      } catch (err) {
        return sendJson(res, 500, { error: "Deletion failed: " + err.code + " - is the data/ directory writable?" });
      }
    }
    
    return sendJson(res, 404, { error: "not found" });
  });
}

// Utility functions for HTTP handling
function tokenFor(password) {
  const crypto = require("crypto");
  return crypto
    .createHmac("sha256", String(password))
    .update("sshmcp-admin-session-v1")
    .digest("hex");
}

function parseCookies(header) {
  if (!header) return {};
  return header.split(";").reduce((cookies, cookie) => {
    const [name, value] = cookie.trim().split("=");
    cookies[name] = value;
    return cookies;
  }, {});
}

function readBody(req) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    let size = 0;
    req.on("data", (c) => { size += c.length; if (size > 1024 * 1024) { req.destroy(); reject(new Error("body too large")); } chunks.push(c); });
    req.on("end", () => resolve(Buffer.concat(chunks).toString("utf8")));
    req.on("error", reject);
  });
}

function send(res, status, type, body) {
  const buf = Buffer.from(body, "utf8");
  res.writeHead(status, {
    "Content-Type": type,
    "Content-Length": buf.length,
    "Access-Control-Allow-Origin": "*"
  });
  res.end(buf);
}

function sendJson(res, status, obj, extraHeaders) {
  const buf = Buffer.from(JSON.stringify(obj, null, 2), "utf8");
  res.writeHead(status, {
    "Content-Type": "application/json",
    "Content-Length": buf.length,
    ...(extraHeaders || {})
  });
  res.end(buf);
}

